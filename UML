@startuml centro_deportivo_zona_activa

enum EstadoEspera {
  ESPERANDO
  ASIGNADO
  CANCELADO
}

class Cancha {
  - codigo : string
  - tipoDeporte : string
  - precioPorHora : double
  - franjasHorarias : char[12]
  + Cancha()
  + Cancha(codigo: string, tipoDeporte: string, precioPorHora: double)
  + ~Cancha()
  + getCodigo() : string
  + getTipoDeporte() : string
  + getPrecioPorHora() : double
  + setPrecioPorHora(precioPorHora: double) : void
  + getEstadoFranja(indice: int) : char
  + cambiarEstadoFranja(indice: int, nuevoEstado: char) : bool
  + calcularPorcentajeOcupacion() : double
  + mostrarDisponibilidad() : void
  + mostrar() : void
}

class Cliente {
  - id : string
  - nombre : string
  - telefono : string
  + Cliente()
  + Cliente(id: string, nombre: string, telefono: string)
  + ~Cliente()
  + getId() : string
  + getNombre() : string
  + getTelefono() : string
  + setNombre(nombre: string) : void
  + setTelefono(telefono: string) : void
  + mostrar() : void
}

class Reserva {
  - idReserva : int
  - cliente : Cliente*
  - cancha : Cancha*
  - franjaInicial : int
  - cantidadFranjas : int
  - monto : double
  - activa : bool
  - {static} contadorReservas : int
  + Reserva(cliente: Cliente*, cancha: Cancha*, fInicio: int, cantFranjas: int, monto: double)
  + ~Reserva()
  + getIdReserva() : int
  + getCliente() : Cliente*
  + getCancha() : Cancha*
  + getFranjaInicial() : int
  + getCantiladFranjas() : int
  + getMonto() : double
  + isActiva() : bool
  + cancelar() : void
  + mostrarInformacion() : void
}

class RegistroEspera {
  - consecutivo : int
  - cliente : Cliente*
  - cancha : Cancha*
  - franjaHoraria : int
  - estado : EstadoEspera
  - {static} contadorEspera : int
  + RegistroEspera(cliente: Cliente*, cancha: Cancha*, franjaHoraria: int)
  + ~RegistroEspera()
  + getConsecutivo() : int
  + getCliente() : Cliente*
  + getCancha() : Cancha*
  + getFranjaHoraria() : int
  + getEstado() : EstadoEspera
  + setEstado(nuevoEstado: EstadoEspera) : void
  + mostrarRegistro() : void
}

class ColeccionCanchas {
  - canchas : Cancha*[10]
  - cantidad : int
  + ColeccionCanchas()
  + ~ColeccionCanchas()
  + agregarCancha(canchaPtr: Cancha*) : bool
  + buscarPorCodigo(codigo: string) : Cancha*
  + listaCanchas() : void
  + getCantidad() : int
  + getCancha(indice: int) : Cancha*
}

class ColeccionClientes {
  - clientes : Cliente*[100]
  - cantidad : int
  + ColeccionClientes()
  + ~ColeccionClientes()
  + agregarCliente(clientePtr: Cliente*) : bool
  + buscarPorId(id: string) : Cliente*
  + listaClientes() : void
  + getCantidad() : int
  + getCliente(indice: int) : Cliente*
}

class ColeccionReservas {
  - reservas : Reserva*[120]
  - cantidad : int
  + ColeccionReservas()
  + ~ColeccionReservas()
  + agregarReserva(reservaPtr: Reserva*) : bool
  + buscarPorNumero(numero: int) : Reserva*
  + listarPorCliente(idCliente: string) : void
  + listarPorCancha(codigoCancha: string) : void
  + listarTodas() : void
  + getCantidad() : int
  + getReserva(indice: int) : Reserva*
}

class ColeccionEspera {
  - listaEspera : RegistroEspera*[100]
  - cantidad : int
  + ColeccionEspera()
  + ~ColeccionEspera()
  + agregarEsperando(clientePtr: Cliente*, canchaPtr: Cancha*, franjaHoraria: int) : bool
  + avisarClientesEnEspera(codigoCancha: string, franjaHoraria: int) : void
  + buscarPorConsecutivo(consecutivo: int) : RegistroEspera*
  + mostrarLista() : void
  + getCantidad() : int
  + getRegistro(indice: int) : RegistroEspera*
}

class SistemaCentroDeportivo {
  - clientes : ColeccionClientes
  - canchas : ColeccionCanchas
  - reservas : ColeccionReservas
  - listaEspera : ColeccionEspera
  - limpiarConsola() : void
  - pausarConsola() : void
  - menuGestionCanchas() : void
  - menuGestionClientes() : void
  - menuGestionReservas() : void
  - menuGestionEspera() : void
  - menuReportesEstadisticas() : void
  + SistemaCentroDeportivo()
  + ~SistemaCentroDeportivo()
  + ejecutar() : void
}

' Relaciones de Asociación y Uso
Reserva "0..*" --> "1" Cliente : cliente
Reserva "0..*" --> "1" Cancha : cancha
RegistroEspera "0..*" --> "1" Cliente : cliente
RegistroEspera "0..*" --> "1" Cancha : cancha
RegistroEspera --> EstadoEspera

' Relaciones de Composición
ColeccionCanchas "1" *-- "0..10" Cancha : contiene
ColeccionClientes "1" *-- "0..100" Cliente : contiene
ColeccionReservas "1" *-- "0..120" Reserva : contiene
ColeccionEspera "1" *-- "0..100" RegistroEspera : contiene

SistemaCentroDeportivo "1" *-- "1" ColeccionCanchas
SistemaCentroDeportivo "1" *-- "1" ColeccionClientes
SistemaCentroDeportivo "1" *-- "1" ColeccionReservas
SistemaCentroDeportivo "1" *-- "1" ColeccionEspera

@enduml
